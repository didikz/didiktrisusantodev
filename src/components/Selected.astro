---
const selected = [
	{
		eyebrow: 'Omcom · 2025–2026',
		title: 'End-to-end platform ownership',
		body: 'Solo product engineer for a Singapore social-commerce platform serving 200+ stores, with 99.956% uptime. Revamped the merchant web app from scratch and launched in about two months.',
		href: '/experience/#omcom',
		cta: 'See the role',
	},
	{
		eyebrow: 'Flip · 2022–2024',
		title: 'Disbursement reliability at scale',
		body: 'Raised created–confirmed API SLA (p95 under 5s) from under 60% to over 95%, and cut p95 latency from over 5s to under 1s while serving 200k+ daily requests.',
		href: '/experience/#flip',
		cta: 'See the role',
	},
	{
		eyebrow: 'Mentoring · 2024–2025',
		title: 'Growing the next engineers',
		body: 'Mentored 20+ interns toward junior roles at Dibimbing.id, crafted coding assessments for bank IT hiring, and taught system design at Nortis Academy Malang.',
		href: '/about/#teaching-heading',
		cta: 'See the work',
	},
];
---

<section class="selected list-block" aria-labelledby="highlights-heading">
	<p class="label" id="highlights-heading">Highlights</p>
	<ul class="items">
		{
			selected.map((item) => (
				<li class="item">
					<p class="eyebrow">{item.eyebrow}</p>
					<h2 class="title">
						<a href={item.href}>{item.title}</a>
					</h2>
					<p class="body">{item.body}</p>
					<p class="cta">
						<a href={item.href}>{item.cta}</a>
					</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.selected {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.cta {
		margin: 0.65rem 0 0;
		font-size: var(--text-sm);
	}

	.cta a {
		color: var(--accent-regular);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
		transition: text-decoration-color var(--theme-transition);
	}

	.cta a:hover,
	.cta a:focus-visible {
		text-decoration-color: currentColor;
	}
</style>
