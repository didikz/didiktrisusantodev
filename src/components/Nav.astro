---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { iconPaths } from './IconPaths';

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Experience', href: '/experience/' },
	{ label: 'About', href: '/about/' },
	{ label: 'Blog', href: 'https://blog.didiktrisusanto.dev/' },
];

/** Icon links to social media */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'Twitter', href: 'https://x.com/didikz', icon: 'twitter-logo' },
	{ label: 'GitHub', href: 'https://github.com/didikz', icon: 'github-logo' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/didik-tri-susanto-16029443/', icon: 'linkedin-logo' },
	{ label: 'Speaker Deck', href: 'https://speakerdeck.com/didikz/', icon: 'presentation' },
];
---

<nav>
	<div class="menu-header">
		<a href="/" class="site-title">Didik Tri Susanto</a>
		<menu-button>
			<template>
				<button class="menu-button" type="button" aria-expanded="false" aria-controls="menu-content">
					<span class="sr-only" data-menu-label>Open menu</span>
					<span class="menu-icon open" aria-hidden="true"><Icon icon="list" /></span>
					<span class="menu-icon close" aria-hidden="true" hidden><Icon icon="x" /></span>
				</button>
			</template>
		</menu-button>
	</div>
	<noscript class="menu-noscript">
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							class:list={[
								'link',
								{
									active:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a
							aria-current={Astro.url.pathname === href}
							class:list={[
								'link',
								{
									active:
										Astro.url.pathname === href ||
										(href !== '/' && Astro.url.pathname.startsWith(href)),
								},
							]}
							href={href}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;
			const label = btn.querySelector('[data-menu-label]')!;
			const openIcon = btn.querySelector<HTMLElement>('.menu-icon.open')!;
			const closeIcon = btn.querySelector<HTMLElement>('.menu-icon.close')!;

			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			menu.classList.add('menu-content');

			const mediaQueries = window.matchMedia('(min-width: 50em)');

			const setExpanded = (expand: boolean) => {
				const isDesktop = mediaQueries.matches;
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
				label.textContent = expand ? 'Close menu' : 'Open menu';
				openIcon.hidden = expand;
				closeIcon.hidden = !expand;
				document.body.classList.toggle('menu-open', expand && !isDesktop);
			};

			btn.addEventListener('click', () => setExpanded(menu.hidden));

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && !menu.hidden && !mediaQueries.matches) {
					setExpanded(false);
					btn.focus();
				}
			});

			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		z-index: 9999;
		position: relative;
		font-family: var(--font-body);
		font-weight: 500;
		margin-bottom: 0.5rem;
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		padding: 1.25rem 1.5rem;
	}

	.site-title {
		line-height: 1.1;
		color: var(--gray-0);
		text-decoration: none;
		font-family: var(--font-brand);
		font-weight: 700;
		font-size: var(--text-base);
		letter-spacing: -0.02em;
	}

	.menu-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--gray-700);
		border-radius: 0.4rem;
		padding: 0;
		font-size: 1.35rem;
		color: var(--gray-200);
		background: transparent;
		cursor: pointer;
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
		border-color: var(--gray-300);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-icon {
		display: flex;
	}

	.menu-content {
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		top: calc(100% - 0.35rem);
		border-radius: 0.5rem;
		overflow: hidden;
		background-color: var(--gray-999);
		border: 1px solid var(--gray-700);
		box-shadow: var(--shadow-md);
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		font-size: var(--text-md);
		line-height: 1.2;
		list-style: none;
		padding: 0.65rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--gray-800);
	}

	.link {
		display: flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.55rem 0.75rem;
		color: var(--gray-300);
		text-decoration: none;
		border-radius: 0.35rem;
	}

	.link.active {
		color: var(--gray-0);
		background-color: var(--accent-subtle-overlay);
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.55rem;

		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 1rem 1rem;
		background-color: var(--gray-999);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		font-size: var(--icon-size);
	}

	.social {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.75rem;
		min-height: 2.75rem;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--accent-regular);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus-visible {
		color: var(--gray-0);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
	}

	:global(body.menu-open) {
		overflow: hidden;
	}

	@media (min-width: 50em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto auto;
			align-items: center;
			padding: 1.75rem 5rem 1rem;
			gap: 1.5rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: var(--text-md);
		}

		.menu-content {
			display: contents;
			position: static;
			left: auto;
			right: auto;
			top: auto;
			border: 0;
			border-radius: 0;
			overflow: visible;
			background: transparent;
			box-shadow: none;
		}

		.nav-items {
			position: relative;
			flex-direction: row;
			align-items: center;
			gap: 0.15rem;
			font-size: var(--text-sm);
			border: 0;
			padding: 0;
			background: transparent;
		}

		.link {
			min-height: 0;
			padding: 0.4rem 0.7rem;
			border-radius: 0.3rem;
			color: var(--gray-200);
			transition: color var(--theme-transition);
		}

		.link:hover,
		.link:focus-visible {
			color: var(--gray-0);
			background: transparent;
		}

		.link.active {
			color: var(--gray-0);
			background: transparent;
			font-weight: 600;
		}

		.menu-footer {
			--icon-padding: 0.4rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			box-shadow: none;
			border: 0;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}

	@media (forced-colors: active) {
		.link.active {
			color: SelectedItem;
		}
	}
</style>
