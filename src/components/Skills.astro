---
type Skill = {
	label: string;
	slug: string;
	mono?: boolean;
};

type SkillGroup = {
	label: string;
	skills: Skill[];
};

const groups: SkillGroup[] = [
	{
		label: 'Languages',
		skills: [
			{ label: 'PHP', slug: 'php' },
			{ label: 'Go', slug: 'go' },
			{ label: 'TypeScript', slug: 'typescript' },
			{ label: 'JavaScript', slug: 'javascript', mono: true },
		],
	},
	{
		label: 'Backend',
		skills: [
			{ label: 'Laravel', slug: 'laravel' },
			{ label: 'MySQL', slug: 'mysql' },
			{ label: 'Redis', slug: 'redis' },
			{ label: 'MongoDB', slug: 'mongodb' },
		],
	},
	{
		label: 'Platform',
		skills: [
			{ label: 'Docker', slug: 'docker' },
			{ label: 'AWS', slug: 'amazonwebservices', mono: true },
			{ label: 'GCP', slug: 'googlecloud' },
			{ label: 'Datadog', slug: 'datadog' },
		],
	},
];
---

<section class="stack-section" aria-labelledby="stack-heading">
	<p class="label" id="stack-heading">Stack</p>
	<div class="groups">
		{
			groups.map((group, gi) => (
				<div class="group">
					<p class="group-label">{group.label}</p>
					<ul class="chips">
						{group.skills.map((skill, i) => (
							<li class="chip" style={`--i: ${gi * 4 + i}`}>
								<img
									class:list={['logo', { mono: skill.mono }]}
									src={`/assets/stack/${skill.slug}.svg`}
									alt=""
									width="16"
									height="16"
									loading="lazy"
								/>
								<span>{skill.label}</span>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.stack-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-300);
	}

	.groups {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}

	.group-label {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--gray-300);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.75rem;
		border: 1px solid var(--gray-700);
		border-radius: 0.5rem;
		background: var(--gray-800);
		color: var(--gray-0);
		font-size: var(--text-sm);
		transition:
			border-color var(--theme-transition),
			background-color var(--theme-transition);
		animation: content-reveal 0.4s var(--motion-ease) both;
		animation-delay: calc(var(--i) * 40ms);
	}

	.chip:hover {
		border-color: var(--accent-regular);
	}

	.logo {
		width: 1em;
		height: 1em;
		flex-shrink: 0;
		object-fit: contain;
		opacity: 0.85;
	}

	:global(.theme-dark) .logo.mono {
		filter: invert(1);
		opacity: 0.9;
	}

	@media (prefers-reduced-motion: reduce) {
		.chip {
			animation: none;
		}
	}
</style>
