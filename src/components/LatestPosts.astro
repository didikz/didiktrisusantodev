---
const blogUrl = 'https://blog.didiktrisusanto.dev/';
---

<section class="latest list-block" aria-labelledby="writing-heading" data-latest-posts>
	<p class="label" id="writing-heading">Latest writing</p>
	<p class="status" data-status>Loading posts…</p>
	<ul class="items" data-list hidden></ul>
	<p class="more">
		<a href={blogUrl}>Read all posts</a>
	</p>
</section>

<script>
	type Post = {
		title: string;
		link: string;
		pubDate: string;
		description: string;
		image: string | null;
	};

	function formatDate(value: string): string {
		const date = new Date(value);
		if (Number.isNaN(date.getTime())) return value;
		return new Intl.DateTimeFormat('en', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}).format(date);
	}

	function renderPosts(list: HTMLUListElement, posts: Post[]) {
		list.replaceChildren();
		for (const post of posts) {
			const li = document.createElement('li');
			li.className = 'item';

			const content = document.createElement('div');
			content.className = 'content';

			const eyebrow = document.createElement('p');
			eyebrow.className = 'eyebrow';
			eyebrow.textContent = formatDate(post.pubDate);

			const title = document.createElement('h2');
			title.className = 'title';
			const link = document.createElement('a');
			link.href = post.link;
			link.textContent = post.title;
			title.append(link);

			content.append(eyebrow, title);

			if (post.description) {
				const body = document.createElement('p');
				body.className = 'body';
				body.textContent = post.description;
				content.append(body);
			}

			li.append(content);

			if (post.image) {
				const imageLink = document.createElement('a');
				imageLink.className = 'thumbnail';
				imageLink.href = post.link;
				imageLink.tabIndex = -1;
				imageLink.setAttribute('aria-hidden', 'true');

				const image = document.createElement('img');
				image.src = post.image;
				image.alt = '';
				image.loading = 'lazy';
				image.decoding = 'async';
				imageLink.append(image);
				li.append(imageLink);
			}

			list.append(li);
		}
	}

	async function loadLatestPosts(root: HTMLElement) {
		const status = root.querySelector<HTMLElement>('[data-status]');
		const list = root.querySelector<HTMLUListElement>('[data-list]');
		if (!status || !list) return;

		try {
			const res = await fetch('/api/posts');
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			const data = (await res.json()) as { posts?: Post[] };
			const posts = data.posts ?? [];

			if (posts.length === 0) {
				status.hidden = true;
				list.hidden = true;
				return;
			}

			renderPosts(list, posts);
			status.hidden = true;
			list.hidden = false;
		} catch {
			status.hidden = true;
			list.hidden = true;
		}
	}

	document.querySelectorAll<HTMLElement>('[data-latest-posts]').forEach((root) => {
		void loadLatestPosts(root);
	});
</script>

<style>
	.latest {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.status {
		margin: 0;
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	.latest :global(.item) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
	}

	.latest :global(.thumbnail) {
		display: block;
		width: clamp(6.5rem, 24vw, 10rem);
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 0.35rem;
		background: var(--gray-800);
	}

	.latest :global(.thumbnail img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--theme-transition);
	}

	.latest :global(.item:hover .thumbnail img) {
		transform: scale(1.03);
	}

	.more {
		margin: 0;
		font-size: var(--text-sm);
	}

	.more a {
		color: var(--accent-regular);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
		transition: text-decoration-color var(--theme-transition);
	}

	.more a:hover,
	.more a:focus-visible {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.latest :global(.item) {
			gap: 1.5rem;
		}

		.latest :global(.thumbnail) {
			width: 12rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.latest :global(.thumbnail img) {
			transition: none;
		}
	}
</style>
