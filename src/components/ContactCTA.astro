---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside class="contact">
	<div class="copy">
		<p class="label">Get in touch</p>
		<h2>Available for new projects — let's talk</h2>
	</div>
	<CallToAction href="mailto:didiktrisusanto@gmail.com">
		Email me
		<Icon icon="paper-plane-tilt" size="1em" />
	</CallToAction>
</aside>

<style>
	.contact {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
		border-top: 1px solid var(--gray-700);
		padding: 3rem 0 1rem;
		max-width: 40rem;
		margin-inline: auto;
		width: 100%;
	}

	.label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-300);
		margin-bottom: 0.5rem;
	}

	h2 {
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--gray-0);
	}

	.copy {
		min-width: 0;
		flex: 1;
	}

	@media (min-width: 50em) {
		.contact {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 4rem 0 1rem;
			gap: 1.5rem;
		}

		h2 {
			font-size: var(--text-lg);
		}
	}
</style>
