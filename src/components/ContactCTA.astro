<aside class="contact">
	<div class="copy">
		<h2>
			Hiring, or starting a project?{' '}
			<a href="mailto:didiktrisusanto@gmail.com">Email me</a>
		</h2>
	</div>
</aside>

<style>
	.contact {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
		border-top: 1px solid var(--gray-700);
		padding: 3rem 0 1rem;
		max-width: 40rem;
		margin-inline: auto;
		width: 100%;
	}

	h2 {
		margin: 0;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--gray-0);
		max-width: 28ch;
		letter-spacing: -0.02em;
		line-height: 1.35;
	}

	h2 a {
		color: var(--accent-regular);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent-regular) 40%, transparent);
		text-underline-offset: 0.18em;
		transition: text-decoration-color var(--theme-transition);
	}

	h2 a:hover,
	h2 a:focus-visible {
		text-decoration-color: currentColor;
	}

	.copy {
		min-width: 0;
		flex: 1;
	}

	@media (min-width: 50em) {
		.contact {
			padding: 4rem 0 1rem;
		}

		h2 {
			font-size: var(--text-xl);
			max-width: 34ch;
		}
	}
</style>
