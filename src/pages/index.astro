---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Skills from '../components/Skills.astro';
import Selected from '../components/Selected.astro';
import LatestPosts from '../components/LatestPosts.astro';
import ContactCTA from '../components/ContactCTA.astro';
---

<BaseLayout
	title="Didik Tri Susanto | Backend Product Engineer"
	description="Product engineer specialized in backend engineering with 13 years of experience, including 6 years remote, building usable, scalable technology across fintech, social commerce, education, and AI."
>
	<main class="page">
		<div class="hero-block">
			<img
				class="portrait"
				alt="Didik Tri Susanto"
				width="96"
				height="96"
				title="Photo of Didik Tri Susanto"
				loading="eager"
				src="/assets/selfprotrait.webp"
			/>
			<div class="hero-copy">
				<Hero
					title="Didik Tri Susanto"
					tagline="Backend-focused product engineer with 13 years of experience, including 6 years remote. I build usable, scalable systems across fintech, social commerce, education, and AI."
					align="start"
					inkStroke
				/>
				<div class="hero-actions">
					<CallToAction href="mailto:didiktrisusanto@gmail.com">
						Email me
						<Icon icon="paper-plane-tilt" size="1em" />
					</CallToAction>
				</div>
			</div>
		</div>

		<Skills />

		<Selected />

		<LatestPosts />

		<ContactCTA />
	</main>
</BaseLayout>

<style>
	.page {
		width: min(100% - 2rem, 42rem);
		margin-inline: auto;
		padding-block: 1rem 4rem;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.hero-block {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
		position: relative;
	}

	.portrait {
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 999rem;
		object-fit: cover;
		object-position: top;
		border: 1px solid var(--gray-700);
	}

	.hero-copy {
		position: relative;
		width: 100%;
	}

	.hero-actions {
		margin-top: 1.25rem;
	}

	.hero-actions :global(a) {
		width: 100%;
	}

	.portrait,
	.hero-copy :global(.title),
	.hero-copy :global(.tagline),
	.hero-actions,
	.hero-copy :global(.ink-stroke) {
		animation: rise 0.55s ease both;
	}

	.hero-copy :global(.tagline) {
		animation-delay: 0.08s;
	}

	.hero-copy :global(.ink-stroke) {
		animation-delay: 0.12s;
	}

	.hero-actions {
		animation-delay: 0.18s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.6rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portrait,
		.hero-copy :global(.title),
		.hero-copy :global(.tagline),
		.hero-actions,
		.hero-copy :global(.ink-stroke) {
			animation: none;
		}
	}

	@media (min-width: 50em) {
		.page {
			padding-block: 1.5rem 5rem;
			gap: 4.5rem;
		}

		.hero-actions :global(a) {
			width: auto;
		}
	}
</style>
