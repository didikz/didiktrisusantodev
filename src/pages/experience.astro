---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ContactCTA from '../components/ContactCTA.astro';

type Role = {
	period: string;
	title: string;
	company: string;
	logo?: string;
	summary: string;
	highlights?: string[];
};

const primary: Role[] = [
	{
		period: '2025 — 2026',
		title: 'Senior Software Engineer',
		company: 'Omcom',
		logo: '/assets/logos/omcom-logo.png',
		summary:
			'Solo product engineer for a Singapore social-commerce platform — web client, APIs, and GCP/AWS infrastructure end to end. Serves 200+ active stores, 100k–200k daily messages, and 7k–8k daily processes at 99.956% uptime.',
		highlights: [
			'Owned the full loop: product ideas, build, test, release, and maintenance',
			'Revamped the merchant web app from scratch (React, Bun, Vite) and launched in ~2 months',
			'Built a chatbot for automatic replies across 3 pilot stores — 75% reply rate on 3.6k messages',
		],
	},
	{
		period: '2022 — 2024',
		title: 'Senior Software Engineer',
		company: 'Flip',
		logo: '/assets/logos/flip-logo.jpg',
		summary:
			'Backend engineer on Flip For Business disbursement — remote from Indonesia — designing scalable product solutions for high-traffic money movement.',
		highlights: [
			'Raised created–confirmed disbursement API monthly SLA (p95 < 5s) from under 60% to over 95%',
			'Cut disbursement API p95 latency from over 5s to under 1s while serving 200k+ daily requests',
			'Migrated five back-office modules from monolith to Go microservices; led SNAP compliance work',
		],
	},
	{
		period: '2020 — 2022',
		title: 'Tech Lead',
		company: 'Avana',
		logo: '/assets/logos/avana.jpg',
		summary:
			'Platform lead for store and dashboard — remote from Bandung — spanning infrastructure, backend delivery, hiring, and release control.',
		highlights: [
			'Modernized store infrastructure from a single VPS to AWS Fargate with 20k+ RPS capacity',
			'Ran load tests to benchmark performance and find improvement targets',
			'Owned backend code review and release control; assessed engineering candidates',
		],
	},
	{
		period: '2018 — 2020',
		title: 'VP of Engineering',
		company: 'DOT Indonesia',
		logo: '/assets/logos/dot.jpg',
		summary:
			'Led five AVPs and grew the engineering organization past 30 people in Malang — standards, coaching, hiring, and community branding.',
		highlights: [
			'Introduced a KPI system to track and monitor team performance',
			'Upgraded development workflow and engineering standards into shared guidelines and tools',
			'Built local tech-community presence that strengthened company branding',
		],
	},
	{
		period: '2016 — 2018',
		title: 'Backend Engineer',
		company: 'DOT Indonesia',
		logo: '/assets/logos/dot.jpg',
		summary:
			'Shipped information systems, loyalty, fintech, and commerce projects while establishing engineering practice across the agency.',
		highlights: [
			'Introduced automated testing and CI/CD with GitLab',
			'Defined system-analysis templates so marketing could proposal work from engineering input',
			'Standardized hiring (tests + interviews) and web engineering conventions',
		],
	},
];

const earlier: Role[] = [
	{
		period: '2016 — 2018',
		title: 'Web Developer',
		company: 'Ayowes',
		logo: '/assets/logos/ayowes.png',
		summary:
			'Concurrent with DOT Indonesia. Built company sites, WordPress projects, and information systems; mentored four interns and helped hire web developers.',
	},
	{
		period: '2013 — 2014',
		title: 'Web Developer & Project Manager',
		company: 'Digital Semesta',
		summary:
			'Managed and shipped three projects with a five-person team — academic journal portal, military web app, and dashboard — plus Telkom payment and API integrations.',
	},
	{
		period: '2012 — 2013',
		title: 'Contributor',
		company: 'Bisakomputer.com',
		logo: '/assets/logos/biskom.png',
		summary: 'Published Windows and Linux articles for a tech publication.',
	},
];
---

<BaseLayout
	title="Experience | Didik Tri Susanto"
	description="Career experience as a backend product engineer across fintech, social commerce, education, and AI."
>
	<main class="page">
		<Hero
			title="Experience"
			tagline="The path wasn't straight, but every step belonged."
			align="start"
		/>

		<ol class="roles">
			{
				primary.map((role) => (
					<li class="role">
						<div class="meta">
							{role.logo && (
								<img class="logo" src={role.logo} alt="" width="20" height="20" loading="lazy" />
							)}
							<span class="company">{role.company}</span>
							<span class="period">{role.period}</span>
						</div>
						<h2 class="role-title">{role.title}</h2>
						<p class="summary">{role.summary}</p>
						{role.highlights && (
							<ul class="highlights">
								{role.highlights.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						)}
					</li>
				))
			}
		</ol>

		<p class="label" id="earlier-heading">Earlier</p>
		<ol class="roles earlier" aria-labelledby="earlier-heading">
			{
				earlier.map((role) => (
					<li class="role">
						<div class="meta">
							{role.logo && (
								<img class="logo" src={role.logo} alt="" width="20" height="20" loading="lazy" />
							)}
							<span class="company">{role.company}</span>
							<span class="period">{role.period}</span>
						</div>
						<h2 class="role-title">{role.title}</h2>
						<p class="summary">{role.summary}</p>
					</li>
				))
			}
		</ol>

		<ContactCTA />
	</main>
</BaseLayout>

<style>
	.page {
		width: min(100% - 2rem, 42rem);
		margin-inline: auto;
		padding-block: 1rem 4rem;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.roles {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.role {
		padding-block: 1.75rem;
		border-top: 1px solid var(--gray-700);
	}

	.roles > .role:last-child {
		border-bottom: 1px solid var(--gray-700);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.65rem;
		margin-bottom: 0.5rem;
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	.period {
		font-family: var(--font-brand);
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--gray-200);
		margin-inline-start: auto;
	}

	.logo {
		width: 1.15rem;
		height: 1.15rem;
		border-radius: 0.2rem;
		object-fit: cover;
		border: 1px solid var(--gray-700);
	}

	.company {
		color: var(--gray-200);
	}

	.role-title {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-0);
		margin: 0 0 0.4rem;
	}

	.summary {
		margin: 0;
		color: var(--gray-200);
		font-size: var(--text-base);
		max-width: 52ch;
	}

	.highlights {
		margin: 0.85rem 0 0;
		padding-left: 1.15rem;
		color: var(--gray-200);
		font-size: var(--text-sm);
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		max-width: 54ch;
	}

	.label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-300);
		margin: 0.5rem 0 0;
	}

	.earlier .role {
		padding-block: 1.25rem;
	}

	.earlier .role-title {
		font-size: var(--text-md);
	}

	@media (min-width: 50em) {
		.page {
			padding-block: 1.5rem 5rem;
			gap: 3rem;
		}

		.role-title {
			font-size: var(--text-xl);
		}
	}
</style>
